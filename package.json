{
  "name": "yt-music-player",
  "productName": "YT Music Player",
  "version": "1.0.0",
  "description": "Minimal YouTube music player",
  "author": "me",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --publish never" },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "com.local.ytmusicplayer",
    "files": ["main.js", "www/**"],
    "win": { "target": "nsis" }
  }
}
